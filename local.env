# Configuration for running OpenLemma on your own computer for development (see AGENTS.md):
#   set -a; . ./local.env; . ./local.secrets.env; set +a; uv run lemma --dev
# Lemma's defaults are the safe ones a public server needs; this file lifts what doesn't matter on your own computer.
# No secrets here: this file is committed.
LEMMA_DAILY_SEARCHES=unlimited
LEMMA_DAILY_BUILDS=unlimited
LEMMA_DAILY_READS=unlimited
LEMMA_DAILY_FEEDBACK=unlimited
