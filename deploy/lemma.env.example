# Copy to deploy/lemma.env (git-ignored) and fill it in: on the server at ~/lemma/deploy/lemma.env, and on your own
# computer for development (see Secrets in deploy/README.md).
LEMMA_GOOGLE_CLIENT_ID=
LEMMA_GOOGLE_CLIENT_SECRET=
# Required: search and lesson building refuse to start without it. TypeSafe's Jev ranks search results,
# sorts lessons into subjects and fact-checks each drafted concept.
TYPESAFE_API_KEY=
# Optional: OpenAlex's free key, so searches draw on this server's own daily allowance rather than one shared
# by every caller at its address (https://openalex.org/settings/api).
OPENALEX_API_KEY=
# Who may read the daily counts at /api/stats: comma-separated emails of signed-in accounts.
LEMMA_ADMINS=
